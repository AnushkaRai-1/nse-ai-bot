# ============================================================
# NSE AI Backend — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

# --- Database (PostgreSQL + TimescaleDB) ---
DATABASE_URL=postgresql+asyncpg://nseai:nseai_dev_password@localhost:5432/nseai
DATABASE_URL_SYNC=postgresql://nseai:nseai_dev_password@localhost:5432/nseai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (RS256 — generate keys with: openssl genrsa -out jwt_private.pem 2048 && openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem) ---
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Data Sources ---
TIINGO_API_KEY=
NEWSAPI_KEY=
GNEWS_API_KEY=

# --- MLflow ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- App ---
APP_NAME=NSE AI Stock Recommendation System
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10
